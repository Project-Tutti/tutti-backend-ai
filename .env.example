HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
MODEL_DIR=/models
RESULTS_DIR=/tmp/results
GPU_ID=0

# ── 온프레미스 배포용 ──
# API Key 인증 (메인 서버와 동일한 값 설정)
AI_SERVER_API_KEY=

# Cloudflare Tunnel 토큰
TUNNEL_TOKEN=

# GCP Project ID (Artifact Registry 이미지 경로용)
GCP_PROJECT_ID=

# ── Redis 연결 (Worker용) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
