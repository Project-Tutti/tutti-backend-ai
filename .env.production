# ═══════════════════════════════════════════════════════════
# Tutti AI Server — 온프레미스 환경 변수
# ═══════════════════════════════════════════════════════════
# 사용법: cp .env.production .env && nano .env

# ── Cloudflare Tunnel ──
TUNNEL_TOKEN=<your-cloudflare-tunnel-token>

# ── GCP Project (Artifact Registry 이미지 경로용) ──
GCP_PROJECT_ID=<your-gcp-project-id>

# ── AI Server ──
LOG_LEVEL=info
